# Postgres — leave DATABASE_URL blank to fall back to local SQLite for dev
DATABASE_URL=postgresql://scanner:scanner@localhost:5432/mikrotik_scanner

# Fernet key for encrypting stored device credentials at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Default lab CHR — used by the CLI scan runner if no --host is passed
CHR_HOST=192.168.56.10
CHR_PORT=8728
CHR_USER=admin
CHR_PASSWORD=
